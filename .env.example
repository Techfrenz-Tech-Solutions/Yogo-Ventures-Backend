# Port the API server listens on. Both frontend dev servers (vite.config.js)
# proxy to this same port, so keep them in sync if you change it.
PORT=7002

# Leave unset for local dev. Set to "production" when actually deployed —
# this enables the JWT_SECRET startup check and disables the permissive
# LAN-wildcard CORS rule (see app.js).
# NODE_ENV=production

# ── Database (see schema.sql for the table definitions) ─────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yogoventures

# Comma-separated list of extra allowed CORS origins (beyond the default
# localhost:5173/5174 dev servers, which are always allowed, plus any
# 192.168.x.x / 10.x.x.x / 172.16-31.x.x LAN origin on any port).
# Only needed for something outside those defaults, e.g. a deployed frontend:
# ALLOWED_ORIGINS=https://admin.example.com,https://www.example.com
ALLOWED_ORIGINS=

# Secret used to sign/verify JWTs. Required — there is no fallback.
# In production, the server refuses to start if this is unset.
# In local dev, a missing value auto-generates a random secret for that run
# only (tokens won't survive a restart), so set a real one here to avoid that.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ── Public asset base URL ────────────────────────────────────────────────
# Origin the browser/email-client can reach this API at (used to build safe
# /storage/... image URLs embedded in the quote-confirmation email; also used
# as the default "Continue Shopping" link target if SHOP_URL is unset).
PUBLIC_ASSET_BASE_URL=http://localhost:7002
SHOP_URL=http://localhost:5173

# ── SMTP (Brevo) — quote confirmation emails ─────────────────────────────
# Never commit real values here — this file only documents the expected
# shape. Put actual credentials in .env (gitignored).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=YoGo Ventures
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
